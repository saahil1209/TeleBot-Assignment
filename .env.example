# Copy to .env for local runs. On Vercel, set these as Environment Variables.
# .env is gitignored and must never be committed.

TELEGRAM_BOT_TOKEN=
# Optional but recommended. Any random string. Pass the same value as
# secret_token when you call setWebhook, and the function will reject any
# request that doesn't carry it.
TELEGRAM_WEBHOOK_SECRET=

GEMINI_API_KEY=
# Optional overrides. Defaults are in api/_lib/gemini.py.
GEMINI_FAST_MODEL=
GEMINI_DRAFT_MODEL=

SUPABASE_URL=https://bcmdgasjjdfwplcwilvb.supabase.co
# Service role key, from Supabase dashboard > Project Settings > API keys.
# Server side only. Never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Notes scoring below this get no draft. Default 6.
SCORE_THRESHOLD=6

# Drafting backend: auto | claude | gemini. Default auto - Claude when a key is
# present, Gemini otherwise. The stack puts drafting on Claude from B1 onward.
DRAFT_BACKEND=gemini
ANTHROPIC_API_KEY=
CLAUDE_DRAFT_MODEL=claude-sonnet-5

# --- Optional: publish to LinkedIn from Telegram ---
# Off by default. Publishing is the one irreversible step, so it is reachable
# only by an explicit PUBLISH on a draft that has already been approved. It
# never happens on a schedule and never as a side effect of approval.
ENABLE_LINKEDIN_PUBLISH=false
# From a LinkedIn Developer app with the w_member_social scope. Member tokens
# expire after about 60 days.
LINKEDIN_ACCESS_TOKEN=
# Either the bare member id or the full urn:li:person:XXXX
LINKEDIN_PERSON_URN=
